{% comment %}
  WOW Sewing purchase-assurance row for the main product section.

  Accepts:
  - block: Product section block containing the four assurance labels.
{% endcomment %}

{% liquid
  assign assurance_count = 0
  assign assurance_1 = block.settings.assurance_1 | strip
  assign assurance_2 = block.settings.assurance_2 | strip
  assign assurance_3 = block.settings.assurance_3 | strip
  assign assurance_4 = block.settings.assurance_4 | strip

  if assurance_1 != blank
    assign assurance_count = assurance_count | plus: 1
  endif
  if assurance_2 != blank
    assign assurance_count = assurance_count | plus: 1
  endif
  if assurance_3 != blank
    assign assurance_count = assurance_count | plus: 1
  endif
  if assurance_4 != blank
    assign assurance_count = assurance_count | plus: 1
  endif
%}

{% if assurance_count > 0 %}
  {{ 'wow-product-assurances.css' | asset_url | stylesheet_tag }}

  <ul
    class="wow-product-assurances{% if block.settings.show_background %} wow-product-assurances--with-background{% endif %}"
    style="--wow-assurances-count: {{ assurance_count }}; --wow-assurances-icon-color: {{ block.settings.icon_color }};"
    role="list"
  >
    {% if assurance_1 != blank %}
      <li class="wow-product-assurances__item">
        <span class="wow-product-assurances__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <rect x="5" y="10" width="14" height="10" rx="2" />
            <path d="M8 10V7a4 4 0 0 1 8 0v3" />
          </svg>
        </span>
        <span class="wow-product-assurances__text" dir="auto">{{ assurance_1 | escape }}</span>
      </li>
    {% endif %}

    {% if assurance_2 != blank %}
      <li class="wow-product-assurances__item">
        <span class="wow-product-assurances__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <rect x="3" y="6" width="18" height="12" rx="2" />
            <path d="M7 10h.01M17 14h.01" />
            <circle cx="12" cy="12" r="2.25" />
          </svg>
        </span>
        <span class="wow-product-assurances__text" dir="auto">{{ assurance_2 | escape }}</span>
      </li>
    {% endif %}

    {% if assurance_3 != blank %}
      <li class="wow-product-assurances__item">
        <span class="wow-product-assurances__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z" />
            <circle cx="7" cy="18" r="2" />
            <circle cx="18" cy="18" r="2" />
          </svg>
        </span>
        <span class="wow-product-assurances__text" dir="auto">{{ assurance_3 | escape }}</span>
      </li>
    {% endif %}

    {% if assurance_4 != blank %}
      <li class="wow-product-assurances__item">
        <span class="wow-product-assurances__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
            <path d="M4 7v5h5" />
            <path d="M5.5 12a7 7 0 1 0 2-5" />
            <path d="M4 7h5" />
          </svg>
        </span>
        <span class="wow-product-assurances__text" dir="auto">{{ assurance_4 | escape }}</span>
      </li>
    {% endif %}
  </ul>
{% endif %}
