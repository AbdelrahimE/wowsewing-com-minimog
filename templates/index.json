class=\"counter-number\" data-target=\"5200\">0<\/div>\n      <div class=\"counter-label\">عملية شراء<\/div>\n    <\/div>\n    \n  <\/div>\n<\/div>\n\n<style>\n  .wow-counter-section {\n    background-color: #f9e7e7; \n    padding: 40px 15px;\n    direction: rtl;\n  }\n  \n  .counter-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: table;\n    width: 100%;\n  }\n\n  .counter-box {\n    display: table-cell;\n    width: 25%;\n    text-align: center;\n    vertical-align: middle;\n    padding: 15px 10px;\n  }\n\n  .counter-number {\n    font-size: 42px;\n    font-weight: bold;\n    color: #1E1E1E;\n    margin-bottom: 8px;\n    display: inline-block;\n  }\n\n  \/* علامات النسبة المئوية والزائد *\/\n  .counter-box:nth-child(1) .counter-number::after { content: \"%\"; }\n  .counter-box:nth-child(2) .counter-number::after { content: \"%\"; }\n  .counter-box:nth-child(3) .counter-number::after { content: \"+\"; }\n  .counter-box:nth-child(4) .counter-number::after { content: \"+\"; }\n\n  .counter-label {\n    font-size: 30px;\n    color: #BF110D;\n    font-weight: 600;\n  }\n\n  \/* شاشة الموبايل: تحويل العدادات إلى مربعات (2 في كل صف) *\/\n  @media screen and (max-width: 767px) {\n    .counter-container {\n      display: block; \/* إلغاء نظام الجدول على الموبايل *\/\n    }\n    .counter-box {\n      display: block;\n      float: right;\n      width: 50%; \/* نصف عرض الشاشة بالظبط عشان يجوا 2 جنب بعض *\/\n      box-sizing: border-box;\n      padding: 5px 5px;\n    }\n    .counter-number {\n      font-size: 34px; \/* تصغير الخط قليلاً ليناسب شاشات الموبايل *\/\n    }\n    .counter-label {\n      font-size: 24px;\n    }\n    \/* مسح العواميد بعد العدادات عشان المظهر العام للموقع *\/\n    .counter-container::after {\n      content: \"\";\n      display: table;\n      clear: both;\n    }\n  }\n<\/style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", () => {\n    const counters = document.querySelectorAll('.counter-number');\n    const speed = 100;\n\n    const startCounter = (counter) => {\n      const updateCount = () => {\n        const target = +counter.getAttribute('data-target');\n        const count = +counter.innerText;\n        const inc = Math.ceil(target \/ speed);\n\n        if (count < target) {\n          counter.innerText = count + inc;\n          setTimeout(updateCount, 20);\n        } else {\n          counter.innerText = target;\n        }\n      };\n      updateCount();\n    };\n\n    const observer = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if(entry.isIntersecting) {\n          startCounter(entry.target);\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.2 });\n\n    counters.forEach(counter => observer.observe(counter));\n  });\n<\/script>","custom_class":""}},"16225125199f82d8fe":{"type":"icon-box","blocks":{"16225125199f82d8fe-0":{"type":"iconbox","settings":{"card_color_scheme":"default","image":"shopify:\/\/shop_images\/free-delivery-free-svgrepo-com.svg","image_by_url":"","link":"","title":"شحن مجاني","heading_size":"h3","description":"<p>شحن مجاني للطلبات فوق 3000 جنيه مصري<\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"m-button--primary","button_size":"m-button--large"}},"16225125199f82d8fe-2":{"type":"iconbox","settings":{"card_color_scheme":"","image":"shopify:\/\/shop_images\/customer-support-svgrepo-com.svg","image_by_url":"","link":"","title":"خدمة العملاء","heading_size":"h3","description":"<p>على مدار 24 ساعة \/ من السبت إلى الخميس<\/p>","text_size":"text-base","button_label":"","button_link":"","button_style":"m-button--link","button_size":""}},"71deafbb-3baf-443a-a087-3f7b8af7b9fa":{"type":"iconbox","settings":{"card_color_scheme":"","image":"shopify:\/\/shop_images\/payment.png","image_by_url":"","link":"","title":"خيارات دفع مرنة","heading_size":"h3","description":"<p>الدفع باستخدام بطاقات ائتمان متعددة<\/p>","text_size":"text-base","button_label":""